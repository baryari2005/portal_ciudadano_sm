# Opcional. Sin esta variable, los campos de dirección funcionan manualmente.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Secreto utilizado por el proceso diario de avisos de vencimiento documental.
DOCUMENT_EXPIRATION_CRON_SECRET=

# Clave estable para cifrar las credenciales QR de asistencia recuperables.
# En producción debe ser larga, aleatoria y no cambiarse después de emitir credenciales.
QR_CREDENTIAL_ENCRYPTION_KEY=

# Cierre automático diario de planillas pendientes.
ATTENDANCE_AUTO_CLOSE_CRON_SECRET=
ATTENDANCE_SYSTEM_ACTOR_ID=
