  inscripcion         Inscripcion      @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  registradoPor       Usuario?         @relation("AsistenciaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([claseActividadId, inscripcionId])
  @@index([claseActividadId])
  @@index([inscripcionId])
  @@index([estado])
  @@index([registradoPorId])
}

model UsuarioQrCredencial {
  id           String          @id @default(cuid())
  usuarioId    String          @db.Uuid
  tokenHash    String          @unique
  tokenCifrado String?         @db.Text
  estado       UsuarioQrEstado @default(ACTIVO)
  version      Int             @default(1)
