generator client {
  provider = "prisma-client-js"
}

generator seedClient {
  provider = "prisma-client-js"
  output   = "./generated/requirements-seed-client"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model Usuario {
  id                         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String         @unique
  tipoDocumento              TipoDocumento? @default(DNI)
  documento                  String?        @unique
  cuil                       String?        @unique
  email                      String         @unique
  celular                    String?
  domicilio                  String?
  localidad                  String?
  provincia                  String?
  codigoPostal               String?
  domicilioPlaceId           String?
  domicilioLat               Float?
  domicilioLng               Float?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  coberturaMedicaId          String?        @db.Uuid
  numeroAfiliado             String?

  nombre          String?
  apellido        String?
  avatarUrl       String?
  fotoPerfilUrl   String?
  fechaNacimiento DateTime?     @db.Date
  genero          Genero?
  estadoCivil     EstadoCivil?
  nacionalidad    Nacionalidad?

  password                      String?
  mustChangePassword            Boolean             @default(false)
  provider                      String?
  providerId                    String?
  perfilCompleto                Boolean             @default(true)
  estado                        EstadoUsuario       @default(ACTIVO)
  estadoParticipacion           EstadoParticipacion @default(HABILITADO)
  umbralAusenciasJustificadas   Int?
  umbralAusenciasInjustificadas Int?
  participacionRevisadaAt       DateTime?
  participacionObservaciones    String?

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  legajo                         Legajo?
  profesor                       Profesor?
  resetTokens                    PasswordResetToken[]
  actividadesAsignadas           ActividadUsuario[]
  inscripciones                  Inscripcion[]
  reservasClase                  ReservaClase[]
  reservasRecursos               ReservaRecurso[]
  asistenciasRegistradas         Asistencia[]           @relation("AsistenciaRegistradaPor")
  clasesAsistenciaCerrada        ClaseActividad[]       @relation("AsistenciaCerradaPor")
  credencialesQr                 UsuarioQrCredencial[]
  credencialesAccesoDigital      AccesoQrDigital[]
  documentosInscripcionSubidos   DocumentoInscripcion[] @relation("DocumentoSubidoPor")
  documentosInscripcionRevisados DocumentoInscripcion[] @relation("DocumentoRevisadoPor")
  notificacionesEmitidas         Notificacion[]         @relation("NotificacionEmisor")
  notificacionesGestionadas      Notificacion[]         @relation("NotificacionGestionadaPor")
  entregasNotificacion           EntregaNotificacion[]
  registrosAuditoria             RegistroAuditoria[]
  accesos                        RegistroAcceso[]       @relation("AccesoUsuario")
  accesosRegistrados             RegistroAcceso[]       @relation("AccesoRegistradoPor")
  accesosAnulados                RegistroAcceso[]       @relation("AccesoAnuladoPor")
  solicitudesAcceso              SolicitudAcceso[]      @relation("SolicitudAccesoUsuario")
  solicitudesAccesoRevisadas     SolicitudAcceso[]      @relation("SolicitudAccesoRevisor")
  coberturaMedica                CoberturaMedica?       @relation(fields: [coberturaMedicaId], references: [id], onDelete: SetNull)
  documentosPersonales           DocumentoUsuario[]     @relation("DocumentoUsuarioTitular")
  documentosPersonalesSubidos    DocumentoUsuario[]     @relation("DocumentoUsuarioSubidoPor")
  documentosPersonalesRevisados  DocumentoUsuario[]     @relation("DocumentoUsuarioRevisadoPor")
  borradoresActividad            ActividadBorrador[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([rolId])
  @@index([estado])
  @@index([perfilCompleto])
  @@index([provider, providerId])
  @@index([apellido, nombre])
  @@index([domicilioPlaceId])
  @@index([coberturaMedicaId])
}

model CoberturaMedica {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String              @unique
  imagenUrl String?
  tipo      CoberturaMedicaTipo
  activo    Boolean             @default(true)
  usuarios  Usuario[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([nombre])
  @@index([tipo])
  @@index([activo])
}

model SolicitudAcceso {
  id            String                @id @default(cuid())
  usuarioId     String                @db.Uuid
  estado        SolicitudAccesoEstado @default(PENDIENTE)
  motivoRechazo String?               @db.VarChar(500)
  enviadaAt     DateTime              @default(now())
  revisadaAt    DateTime?
  revisadaPorId String?               @db.Uuid
  usuario       Usuario               @relation("SolicitudAccesoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  revisadaPor   Usuario?              @relation("SolicitudAccesoRevisor", fields: [revisadaPorId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([usuarioId, enviadaAt])
  @@index([estado])
  @@index([revisadaPorId])
}

model Notificacion {
  id                String                    @id @default(cuid())
  emisorId          String?                   @db.Uuid
  audiencia         NotificacionAudiencia     @default(INDIVIDUAL)
  rolDestinatarioId Int?
  tipo              NotificacionTipo
  titulo            String
  mensaje           String
  prioridad         NotificacionPrioridad     @default(NORMAL)
  estadoGestion     NotificacionGestionEstado @default(INFORMATIVA)
  gestionadaPorId   String?                   @db.Uuid
  gestionadaAt      DateTime?
  resultadoGestion  String?
  actionUrl         String?
  actionLabel       String?
  entidadTipo       String?
  entidadId         String?
  metadata          Json?
  deduplicationKey  String?                   @unique
  emisor            Usuario?                  @relation("NotificacionEmisor", fields: [emisorId], references: [id], onDelete: SetNull)
  rolDestinatario   Rol?                      @relation(fields: [rolDestinatarioId], references: [id], onDelete: SetNull)
  gestionadaPor     Usuario?                  @relation("NotificacionGestionadaPor", fields: [gestionadaPorId], references: [id], onDelete: SetNull)
  entregas          EntregaNotificacion[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([emisorId])
  @@index([audiencia])
  @@index([rolDestinatarioId])
  @@index([estadoGestion])
  @@index([tipo])
  @@index([prioridad])
  @@index([createdAt])
  @@index([deduplicationKey])
}

model EntregaNotificacion {
  id             String             @id @default(cuid())
  notificacionId String
  usuarioId      String             @db.Uuid
  origen         NotificacionOrigen @default(INDIVIDUAL)
  estado         NotificacionEstado @default(NO_LEIDA)
  leidaAt        DateTime?
  archivadaAt    DateTime?
  notificacion   Notificacion       @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario        Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([notificacionId, usuarioId])
  @@index([usuarioId, estado])
  @@index([notificacionId])
  @@index([origen])
}

model RegistroAuditoria {
  id            String           @id @default(cuid())
  actorId       String?          @db.Uuid
  actorNombre   String?
  actorEmail    String?
  accion        AuditoriaAccion
  entidadTipo   AuditoriaEntidad
  entidadId     String?
  entidadNombre String?
  cambios       Json?
  metadata      Json?
  origen        AuditoriaOrigen
  ipHash        String?
  userAgent     String?
  actor         Usuario?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([actorId])
  @@index([accion])
  @@index([entidadTipo])
  @@index([entidadId])
  @@index([origen])
  @@index([createdAt])
  @@index([entidadTipo, entidadId, createdAt])
}

model ParametrosGenerales {
  id                    Int      @id @default(1)
  registrosPorPagina    Int      @default(6)
  imagenLoginCollage1   String?
  imagenLoginCollage2   String?
  imagenLoginCollage3   String?
  imagenLoginCollage4   String?
  paletasExperiencia    Json?
  updatedById           String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UsuarioBorrador {
  id              String   @id @default(cuid())
  ownerId         String   @db.Uuid
  subjectUserId   String?  @db.Uuid
  scope           String
  mode            String
  payload         Json
  currentStep     Int      @default(1)
  stepStatuses    Json
  viewMode        String   @default("workflow")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId, scope, mode, updatedAt])
  @@index([subjectUserId])
}

model Profesor {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String         @unique @db.Uuid
  especialidad String?
  descripcion  String?
  matricula    String?
  fotoUrl      String?
  estado       ProfesorEstado @default(ACTIVO)

  usuario  Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  horarios HorarioActividadProfesor[]
  clases   ClaseActividadProfesor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([especialidad])
}

model Establecimiento {
  id          String              @id
  nombre      String
  direccion   String
  barrio      String?
  localidad   String?
  provincia   String?
  direccionPlaceId String?
  direccionLat Float?
  direccionLng Float?
  codigoPostal String?
  imagenUrl   String?
  tipo        EstablecimientoTipo @default(SEDE)
  activo      Boolean             @default(true)
  email       String?
  telefono    String?
  celular     String?
  estado      String              @default("activo")
  observacion String?

  actividades       Actividad[]
  horarios          HorarioEstablecimiento[]
  horariosActividad HorarioActividad[]
  clases            ClaseActividad[]
  registrosAcceso   RegistroAcceso[]
  recursos          Recurso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
  @@index([tipo])
  @@index([direccionPlaceId])
}

model HorarioEstablecimiento {
  id                String @id @default(cuid())
  establecimientoId String

  diaSemana    String
  horaApertura String
  horaCierre   String
  cerrado      Boolean @default(false)

  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establecimientoId])
}

model Actividad {
  id                   String  @id
  establecimientoId    String
  categoriaActividadId String? @db.Uuid

  nombre                      String
  descripcionCorta            String?
  descripcion                 String?
  imagenUrl                   String?
  color                       String?
  nivel                       ActividadNivel?
  categoria                   ActividadCategoria   @default(EDUCACION)
  responsableId               String?
  responsableNombre           String?
  cupoMaximo                  Int                  @default(0)
  edadMinima                  Int?
  edadMaxima                  Int?
  cupo                        Int?
  requiereCertificadoMedico   Boolean              @default(false)
  requiereAutorizacion        Boolean              @default(false)
  esGratuita                  Boolean              @default(true)
  precio                      Decimal?             @db.Decimal(12, 2)
  estado                      ActividadEstado      @default(BORRADOR)
  estadoTexto                 String?              @default("borrador")
  modalidadInscripcion        ModalidadInscripcion @default(PERMANENTE)
  duracionPeriodoMeses        Int?
  horasCancelacionJustificada Int                  @default(24)
  modalidadOperacion          ActividadModalidad   @default(HORARIO_FIJO)
  vigenciaReserva             VigenciaReserva      @default(INDEFINIDA)
  duracionTurnoMinutos        Int?
  intervaloTurnoMinutos       Int                  @default(0)
  anticipacionReservaDias     Int                  @default(30)
  limiteReservasPorUsuario    Int?
  requiereReserva             Boolean              @default(true)

  establecimiento    Establecimiento            @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  categoriaActividad CategoriaActividad?        @relation(fields: [categoriaActividadId], references: [id], onDelete: SetNull)
  horarios           HorarioActividad[]
  asignados          ActividadUsuario[]
  publicosObjetivo   ActividadPublicoObjetivo[]
  requisitos         ActividadRequisito[]
  recursos           ActividadRecurso[]
  borrador           ActividadBorrador?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establecimientoId])
  @@index([categoriaActividadId])
  @@index([categoria])
  @@index([estado])
}

model ActividadBorrador {
  id          String              @id @default(cuid())
  creadoPorId String              @db.Uuid
  actividadId String?             @unique
  nombre      String              @default("Actividad sin nombre")
  modalidad   ActividadModalidad?
  pasoActual  Int                 @default(1)
  payload     Json
  estado      String              @default("INCOMPLETO")
  publicadoAt DateTime?
  creadoPor   Usuario             @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  actividad   Actividad?          @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([creadoPorId])
  @@index([estado])
  @@index([updatedAt])
}

model Requisito {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                 String
  slug                   String                  @unique
  descripcion            String?
  tipo                   RequisitoTipo
  requiereDocumento      Boolean                 @default(false)
  documentoPersonal      Boolean                 @default(false)
  tieneVencimiento       Boolean                 @default(false)
  vigenciaDias           Int?
  diasAvisoVencimiento   Int                     @default(30)
  obligatoriedad         RequisitoObligatoriedad @default(OBLIGATORIO)
  provistoPorInstitucion Boolean                 @default(false)
  requiereConfirmacion   Boolean                 @default(false)
  controlarAlIngreso     Boolean                 @default(false)
  aplicaEnCadaClase      Boolean                 @default(false)
  instrucciones          String?
  orden                  Int                     @default(0)
  activo                 Boolean                 @default(true)
  actividades            ActividadRequisito[]
  documentos             DocumentoInscripcion[]
  documentosUsuario      DocumentoUsuario[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([nombre])
  @@index([tipo])
  @@index([activo])
  @@index([orden])
}

model DocumentoUsuario {
  id                      String                     @id @default(cuid())
  usuarioId               String                     @db.Uuid
  requisitoId             String                     @db.Uuid
  version                 Int
  estado                  DocumentoInscripcionEstado @default(PENDIENTE)
  nombreOriginal          String
  storagePath             String
  mimeType                String
  extension               String?
  tamanioBytes            Int
  sha256                  String?
  requisitoNombreSnapshot String
  instruccionesSnapshot   String?
  observacionesCiudadano  String?
  motivoRechazo           String?
  observacionesRevision   String?
  fechaVencimiento        DateTime?                  @db.Date
  subidoPorId             String                     @db.Uuid
  revisadoPorId           String?                    @db.Uuid
  subidoAt                DateTime                   @default(now())
  revisadoAt              DateTime?
  usuario                 Usuario                    @relation("DocumentoUsuarioTitular", fields: [usuarioId], references: [id], onDelete: Restrict)
  requisito               Requisito                  @relation(fields: [requisitoId], references: [id], onDelete: Restrict)
  subidoPor               Usuario                    @relation("DocumentoUsuarioSubidoPor", fields: [subidoPorId], references: [id], onDelete: Restrict)
  revisadoPor             Usuario?                   @relation("DocumentoUsuarioRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([usuarioId, requisitoId, version])
  @@index([usuarioId])
  @@index([requisitoId])
  @@index([estado])
  @@index([subidoAt])
}

model ActividadRequisito {
  id            String    @id @default(cuid())
  actividadId   String
  requisitoId   String    @db.Uuid
  obligatorio   Boolean   @default(true)
  observaciones String?
  orden         Int       @default(0)
  actividad     Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  requisito     Requisito @relation(fields: [requisitoId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@unique([actividadId, requisitoId])
  @@index([actividadId])
  @@index([requisitoId])
}

model HorarioActividad {
  id                String @id @default(cuid())
  actividadId       String
  establecimientoId String

  diaSemana             DiaSemana              @map("dia")
  horaInicio            String
  horaFin               String
  espacio               String?
  observaciones         String?
  cupoMaximo            Int
  permiteListaEspera    Boolean                @default(true)
  permiteSobrecupo      Boolean                @default(false)
  sobrecupoMaximo       Int?
  estado                HorarioActividadEstado @default(ACTIVO)
  duracionTurnoMinutos  Int?
  intervaloTurnoMinutos Int                    @default(0)

  actividad           Actividad                  @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  establecimiento     Establecimiento            @relation(fields: [establecimientoId], references: [id], onDelete: Restrict)
  profesores          HorarioActividadProfesor[]
  inscripciones       Inscripcion[]
  alcancesInscripcion InscripcionHorario[]
  clases              ClaseActividad[]
  recursos            HorarioActividadRecurso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actividadId])
  @@index([establecimientoId])
  @@index([diaSemana])
  @@index([estado])
  @@map("ActividadHorario")
}

model HorarioActividadProfesor {
  id                 String  @id @default(cuid())
  horarioActividadId String
  profesorId         String  @db.Uuid
  esPrincipal        Boolean @default(false)

  horarioActividad HorarioActividad @relation(fields: [horarioActividadId], references: [id], onDelete: Cascade)
  profesor         Profesor         @relation(fields: [profesorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([horarioActividadId, profesorId])
  @@index([horarioActividadId])
  @@index([profesorId])
  @@map("ActividadHorarioProfesor")
}

model ClaseActividad {
  id                     String                   @id @default(cuid())
  horarioActividadId     String
  fecha                  DateTime                 @db.Date
  horaInicio             String
  horaFin                String
  establecimientoId      String
  espacio                String?
  estado                 ClaseActividadEstado     @default(PROGRAMADA)
  observaciones          String?
  cupoMaximo             Int?
  motivoCancelacion      String?
  horarioActividad       HorarioActividad         @relation(fields: [horarioActividadId], references: [id], onDelete: Restrict)
  establecimiento        Establecimiento          @relation(fields: [establecimientoId], references: [id], onDelete: Restrict)
  profesores             ClaseActividadProfesor[]
  asistencias            Asistencia[]
  registrosAcceso        RegistroAcceso[]
  reservas               ReservaClase[]
  bloqueosRecursos       BloqueoRecurso[]
  asistenciaCerradaAt    DateTime?
  asistenciaCerradaPorId String?                  @db.Uuid
  asistenciaCerradaPor   Usuario?                 @relation("AsistenciaCerradaPor", fields: [asistenciaCerradaPorId], references: [id], onDelete: SetNull)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([horarioActividadId, fecha, horaInicio])
  @@index([horarioActividadId])
  @@index([establecimientoId])
  @@index([fecha])
  @@index([estado])
  @@index([asistenciaCerradaPorId])
}

model ClaseActividadProfesor {
  id               String         @id @default(cuid())
  claseActividadId String
  profesorId       String         @db.Uuid
  esPrincipal      Boolean        @default(false)
  claseActividad   ClaseActividad @relation(fields: [claseActividadId], references: [id], onDelete: Cascade)
  profesor         Profesor       @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@unique([claseActividadId, profesorId])
  @@index([claseActividadId])
  @@index([profesorId])
}

model Inscripcion {
  id                 String               @id @default(cuid())
  usuarioId          String               @db.Uuid
  horarioActividadId String
  estado             InscripcionEstado    @default(PENDIENTE)
  fechaInscripcion   DateTime             @default(now())
  fechaConfirmacion  DateTime?
  fechaListaEspera   DateTime?
  fechaCancelacion   DateTime?
  motivoRechazo      String?
  motivoCancelacion  String?
  observaciones      String?
  nivelInformado     ActividadNivel?
  nivelConsentidoAt  DateTime?
  modalidad          ModalidadInscripcion @default(PERMANENTE)
  fechaInicio        DateTime?            @db.Date
  fechaFin           DateTime?            @db.Date

  usuario          Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  horarioActividad HorarioActividad       @relation(fields: [horarioActividadId], references: [id], onDelete: Restrict)
  asistencias      Asistencia[]
  documentos       DocumentoInscripcion[]
  registrosAcceso  RegistroAcceso[]
  reservas         ReservaClase[]
  horarios         InscripcionHorario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, horarioActividadId])
  @@index([usuarioId])
  @@index([horarioActividadId])
  @@index([estado])
  @@index([fechaInscripcion])
  @@index([fechaListaEspera])
}

model InscripcionHorario {
  id                 String           @id @default(cuid())
  inscripcionId      String
  horarioActividadId String
  horaInicio         String?
  horaFin            String?
  inscripcion        Inscripcion      @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  horarioActividad   HorarioActividad @relation(fields: [horarioActividadId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@unique([inscripcionId, horarioActividadId, horaInicio])
  @@index([horarioActividadId])
  @@map("InscripcionHorario")
}

model ReservaClase {
  id                     String             @id @default(cuid())
  claseActividadId       String
  usuarioId              String             @db.Uuid
  inscripcionId          String?
  estado                 ReservaClaseEstado @default(RESERVADA)
  confirmadoAt           DateTime?
  ofrecidoAt             DateTime?
  ofertaVenceAt          DateTime?
  canceladoAt            DateTime?
  motivoCancelacion      String?
  cancelacionJustificada Boolean?
  comprobanteUrl         String?
  posicionEsperaAt       DateTime?
  claseActividad         ClaseActividad     @relation(fields: [claseActividadId], references: [id], onDelete: Restrict)
  usuario                Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  inscripcion            Inscripcion?       @relation(fields: [inscripcionId], references: [id], onDelete: SetNull)
  recursos               ReservaRecurso[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([claseActividadId, usuarioId])
  @@index([claseActividadId, estado])
  @@index([usuarioId, estado])
  @@index([inscripcionId])
  @@index([ofertaVenceAt])
}

model Recurso {
  id                String                    @id @default(cuid())
  establecimientoId String
  nombre            String
  codigo            String
  descripcion       String?
  tipo              RecursoTipo
  modoReserva       RecursoModoReserva        @default(CAPACIDAD)
  capacidadUnidades Int                       @default(1)
  estado            RecursoEstado             @default(ACTIVO)
  establecimiento   Establecimiento           @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  actividades       ActividadRecurso[]
  horarios          HorarioActividadRecurso[]
  reservas          ReservaRecurso[]
  bloqueos          BloqueoRecurso[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([establecimientoId, codigo])
  @@index([establecimientoId, tipo, estado])
}

model ActividadRecurso {
  id                   String                      @id @default(cuid())
  actividadId          String
  recursoId            String
  cantidadNecesaria    Int                         @default(1)
  estrategiaAsignacion EstrategiaAsignacionRecurso @default(AL_INGRESAR)
  exclusivo            Boolean                     @default(false)
  actividad            Actividad                   @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  recurso              Recurso                     @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())

  @@unique([actividadId, recursoId])
  @@index([recursoId])
}

model HorarioActividadRecurso {
  id                   String                      @id @default(cuid())
  horarioActividadId   String
  recursoId            String
  cantidadReservada    Int                         @default(1)
  estrategiaAsignacion EstrategiaAsignacionRecurso @default(AL_INGRESAR)
  exclusivo            Boolean                     @default(false)
  horarioActividad     HorarioActividad            @relation(fields: [horarioActividadId], references: [id], onDelete: Cascade)
  recurso              Recurso                     @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())

  @@unique([horarioActividadId, recursoId])
  @@index([recursoId])
}

model ReservaRecurso {
  id                 String               @id @default(cuid())
  recursoId          String
  reservaClaseId     String?
  usuarioId          String?              @db.Uuid
  fecha              DateTime             @db.Date
  horaInicio         String
  horaFin            String
  cantidad           Int                  @default(1)
  estado             ReservaRecursoEstado @default(RESERVADA)
  asignadoAlIngresar Boolean              @default(false)
  recurso            Recurso              @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  reservaClase       ReservaClase?        @relation(fields: [reservaClaseId], references: [id], onDelete: Cascade)
  usuario            Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([recursoId, fecha, horaInicio, horaFin, estado])
  @@index([reservaClaseId])
  @@index([usuarioId])
}

model BloqueoRecurso {
  id               String               @id @default(cuid())
  recursoId        String
  claseActividadId String?
  fecha            DateTime             @db.Date
  horaInicio       String
  horaFin          String
  cantidad         Int                  @default(1)
  motivo           String
  origen           BloqueoRecursoOrigen @default(MANUAL)
  recurso          Recurso              @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  claseActividad   ClaseActividad?      @relation(fields: [claseActividadId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())

  @@index([recursoId, fecha, horaInicio, horaFin])
  @@index([claseActividadId])
}

model DocumentoInscripcion {
  id                      String                     @id @default(cuid())
  inscripcionId           String
  requisitoId             String                     @db.Uuid
  version                 Int
  estado                  DocumentoInscripcionEstado @default(PENDIENTE)
  nombreOriginal          String
  storagePath             String
  mimeType                String
  extension               String?
  tamanioBytes            Int
  sha256                  String?
  requisitoNombreSnapshot String
  obligatorioSnapshot     Boolean
  instruccionesSnapshot   String?
  observacionesCiudadano  String?
  motivoRechazo           String?
  observacionesRevision   String?
  subidoPorId             String                     @db.Uuid
  revisadoPorId           String?                    @db.Uuid
  subidoAt                DateTime                   @default(now())
  revisadoAt              DateTime?
  inscripcion             Inscripcion                @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  requisito               Requisito                  @relation(fields: [requisitoId], references: [id], onDelete: Restrict)
  subidoPor               Usuario                    @relation("DocumentoSubidoPor", fields: [subidoPorId], references: [id], onDelete: Restrict)
  revisadoPor             Usuario?                   @relation("DocumentoRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([inscripcionId, requisitoId, version])
  @@index([inscripcionId])
  @@index([requisitoId])
  @@index([estado])
  @@index([subidoAt])
  @@index([revisadoAt])
}

model Asistencia {
  id                  String           @id @default(cuid())
  claseActividadId    String
  inscripcionId       String
  estado              AsistenciaEstado
  origen              AsistenciaOrigen @default(MANUAL)
  horaRegistro        DateTime?
  motivoJustificacion String?
  observaciones       String?
