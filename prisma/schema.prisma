  updatedAt         DateTime        @updatedAt

  @@index([usuarioId])
  @@index([establecimientoId])
  @@index([resultado])
  @@index([motivo])
  @@index([origen])
  @@index([registradoPorId])
  @@index([fechaHora])
  @@index([claseActividadId])
  @@index([inscripcionId])
  @@index([anuladoAt])
}

model ActividadUsuario {
  id          String @id @default(cuid())
  actividadId String
  usuarioId   String @db.Uuid

  funcion String?
  activo  Boolean @default(true)

  actividad Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([actividadId, usuarioId])
  @@index([actividadId])
  @@index([usuarioId])
}

model ActividadPublicoObjetivo {
  id                String @id @default(cuid())
  actividadId       String
  publicoObjetivoId String @db.Uuid

