{
  "name": "dashboard-rbac",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.rols.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "seed:permisos": "ts-node seed/permisosSeed.ts",
    "postinstall": "prisma generate",
    "clean": "rimraf .next .turbo .vercel/output .vercel/out .eslintcache",
    "clean:deps": "rimraf node_modules package-lock.json pnpm-lock.yaml yarn.lock",
    "clean:all": "npm run clean && npm run clean:deps",
    "reset:hard": "npm run clean:all && npm i",
    "rebuild": "npm run clean && npm run build",
    "db:seed": "prisma db seed",
    "seed:requirements": "tsx prisma/seed.requirements.ts",
    "seed:enrollment-documents": "tsx prisma/seed.enrollment-documents.ts",
    "setup:enrollment-documents-storage": "tsx --env-file=.env scripts/setup-enrollment-documents-storage.ts",
    "seed:notifications": "tsx prisma/seed.notifications.ts",
    "seed:audit-log": "tsx prisma/seed.audit-log.ts",
    "seed:reports": "tsx prisma/seed.reports.ts",
    "seed:access": "tsx prisma/seed.access.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.16",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.6",
    "openai": "^6.34.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "supabase": "^2.85.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
